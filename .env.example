# Copier ce fichier vers .env et renseigner vos propres identifiants.
# Ne jamais commiter .env (deja dans .gitignore) ni y placer des identifiants de production partages.

# --- OVH Data Platform (Trino) ---------------------------------------------
# Acces lecture/ecriture, utilise par les jobs de synchronisation
OVH_API_KEY=
OVH_SECRET_KEY=
# Acces lecture seule, utilise par les routes de consultation (/predict/results, /user/search, ...)
OVH_API_KEY_READ_ONLY=
OVH_SECRET_KEY_READ_ONLY=

# --- Authentification API (roles) ------------------------------------------
# Role admin (fallback historique CLIENT_KEY/CLIENT_SECRET egalement accepte)
CLIENT_KEY_ADMIN=
CLIENT_SECRET_ADMIN=
# Role lecture seule Webgerest
CLIENT_KEY_WEBGEREST_RO=
CLIENT_SECRET_WEBGEREST_RO=
# Role lecture seule Webresto
CLIENT_KEY_WEBRESTO_RO=
CLIENT_SECRET_WEBRESTO_RO=

# --- Secrets par etablissement/serveur source (JSON) -----------------------
# Format : {"https://api.webgerest.example.com": {"client_key": "...", "client_secret": "..."}}
WEBGEREST_SECRETS={}
# Format : {"https://api.webresto.example.com": "cle_api"}
WEBRESTO_SECRETS={}

# --- Superset (dashboards) --------------------------------------------------
# Format : {"centre": "https://superset.example.com"}
SUPERSET_URLS={}
SUPERSET_USERNAME=
SUPERSET_PASSWORD=
